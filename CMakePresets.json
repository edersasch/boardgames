{
    "version": 8,
    "configurePresets": [
        {
            "name": "MSVC",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/${presetName}/install",
                "CPM_SOURCE_CACHE": "${sourceDir}/build/cpm-source-cache"
            }
        },
        {
            "name": "MSVC-Debug",
            "inherits": "MSVC",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "GCC",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/${presetName}/install",
                "CPM_SOURCE_CACHE": "${sourceDir}/build/cpm-source-cache"
            }
        },
        {
            "name": "GCC-Debug",
            "inherits": "GCC",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}
